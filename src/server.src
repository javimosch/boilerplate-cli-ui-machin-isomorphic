// server.src — the native binary: a CLI that runs an HTTP server. It serves the
// SSR HTML (first paint, works with no JS), its own wasm client, and a JSON API.
// Composed with machweb + flags + models. Holds the authoritative vote state.

var votes = []int{}

func init_votes() {
    seed := []int{5, 3, 2, 4}
    i := 0
    while i < n_opts() {
        votes = append(votes, seed[i])
        i = i + 1
    }
}

func total_votes() (t) {
    t = 0
    i := 0
    while i < n_opts() { t = t + votes[i]  i = i + 1 }
}

func leader_idx() (bi) {
    bi = 0
    bv := 0 - 1
    i := 0
    while i < n_opts() {
        if votes[i] > bv { bv = votes[i]  bi = i }
        i = i + 1
    }
}

// ssr_app renders the poll server-side. The data-s span names match the client's
// slots ("opt_0".."opt_3", "total", "leader"), so the wasm client hydrates this
// exact DOM rather than re-rendering it.
func ssr_app() (h) {
    h = "<h1>Favorite language?</h1><div class=opts>"
    i := 0
    while i < n_opts() {
        h = h + "<button class=opt data-opt=\"" + str(i) + "\">"
        h = h + "<span class=lbl>" + opt_label(i) + "</span>"
        h = h + "<span class=cnt><span data-s=\"opt_" + str(i) + "\">" + str(votes[i]) + "</span></span>"
        h = h + "</button>"
        i = i + 1
    }
    h = h + "</div><p class=foot>total <b><span data-s=\"total\">" + str(total_votes())
    h = h + "</span></b> · leading <b><span data-s=\"leader\">" + opt_label(leader_idx()) + "</span></b></p>"
}

func page() (h) {
    h = "<!doctype html><html lang=en><head><meta charset=utf-8>"
    h = h + "<meta name=viewport content=\"width=device-width,initial-scale=1\">"
    h = h + "<title>machin · isomorphic poll</title>" + styles() + "</head><body>"
    h = h + "<main class=card><div id=app>" + ssr_app() + "</div></main>"
    h = h + "<script>window.__SEED=[" + ints_csv(votes) + "]</script>"
    h = h + "<script type=module>" + host_js() + "</script>"
    h = h + "</body></html>"
}

// qval reads an integer query parameter (?key=N), or -1 if absent.
func qval(path, key) (v) {
    v = 0 - 1
    i := index(path, key + "=")
    if i >= 0 {
        rest := substr(path, i + len(key) + 1, len(path))
        amp := index(rest, "&")
        if amp >= 0 { rest = substr(rest, 0, amp) }
        v = parse_int(rest)
    }
}

// bound_host records what serve actually bound. /_shutdown is token-gated
// whenever it is not loopback (cli-daemon-spec §3).
var bound_host = "127.0.0.1"

func is_loopback(h) (ok) {
    ok = false
    if h == "127.0.0.1" { ok = true }
    if h == "localhost" { ok = true }
    if h == "::1" { ok = true }
}

func shutdown_authorized(req) (ok) {
    if is_loopback(bound_host) {
        ok = true
        return
    }
    token := env("SHUTDOWN_TOKEN")
    ok = false
    if len(token) == 0 { return }
    ok = req.headers["x-shutdown-token"] == token
}

func handle(req) (res) {
    // ---- daemon lifecycle (cli-daemon-spec §2, §3) ----
    if has_prefix(req.path, "/_health") {
        // Open and cheap: liveness only, no dependency checks.
        return ok_json("{\"ok\":true,\"service\":\"machin-poll\",\"pid\":" + str(getpid()) + "}")
    }
    if has_prefix(req.path, "/_shutdown") {
        if req.method != "POST" {
            return response("405 Method Not Allowed", "application/json",
                "{\"ok\":false,\"error\":{\"code\":85,\"type\":\"method_not_allowed\",\"message\":\"POST /_shutdown\",\"recoverable\":false}}")
        }
        if shutdown_authorized(req) == false {
            // 403, and the process MUST NOT stop.
            return response("403 Forbidden", "application/json",
                "{\"ok\":false,\"error\":{\"code\":90,\"type\":\"forbidden\",\"message\":\"X-Shutdown-Token required when bound off-loopback\",\"recoverable\":false}}")
        }
        // Answered by the caller's connection before the process goes away.
        go shutdown_soon()
        return ok_json("{\"ok\":true,\"stopping\":true}")
    }

    // ---- the guide over HTTP (cli-guide-spec §3) ----
    if has_prefix(req.path, "/guide") {
        return ok_json(guide_json())
    }
    if has_prefix(req.path, "/llms.txt") {
        return response("200 OK", "text/plain; charset=utf-8", llms_txt())
    }

    if req.path == "/app.wasm" {
        return ok_wasm(read_file_bytes("app.wasm"))   // one binary serves its own SPA
    }
    if has_prefix(req.path, "/api/vote") {
        o := qval(req.path, "o")
        if o >= 0 {
            if o < n_opts() { votes[o] = votes[o] + 1 }
        }
        return ok_json("{\"ok\":true,\"results\":[" + ints_csv(votes) + "]}")
    }
    if has_prefix(req.path, "/api/results") {
        return ok_json("[" + ints_csv(votes) + "]")
    }
    return ok_html(page())
}

// shutdown_soon lets the /_shutdown response reach the caller before the
// process exits.
func shutdown_soon() {
    sleep(50)
    shell("rm -f " + pid_path())
    exit(0)
}

func run_server(host, port) {
    init_votes()
    bound_host = host
    eprintln("machin · isomorphic poll on http://" + host + ":" + str(port))
    serve_on(host, port, func(req) { return handle(req) })
}

func main() {
    a := args()
    cmd := "help"
    if len(a) > 1 { cmd = a[1] }

    if cmd == "serve" {
        run_server(cli_host(a), cli_port(a))
        return
    }

    if cmd == "daemon" {
        sub := ""
        if len(a) > 2 { sub = a[2] }
        if sub == "start" {
            daemon_start(cli_host(a), cli_port(a))
        } else if sub == "stop" {
            daemon_stop(cli_port(a))
        } else if sub == "status" {
            daemon_status(cli_port(a))
        } else {
            die(85, "unknown_command", "unknown daemon subcommand \"" + sub + "\"",
                "machin-poll daemon status")
        }
        return
    }

    if cmd == "guide" {
        if cli_has_flag(a, "--human") {
            println(guide_markdown())
        } else {
            println(guide_json())
        }
        return
    }

    if cmd == "help-json" {
        println(help_json())
        return
    }

    if cmd == "version" {
        if cli_has_flag(a, "--json") {
            println("{\"version\":\"" + tool_version() + "\",\"name\":\"" + tool_name() + "\"}")
        } else {
            println(tool_name() + " v" + tool_version())
        }
        return
    }

    if cmd == "help" {
        cli_usage()
        return
    }

    die(85, "unknown_command", "unknown command \"" + cmd + "\"", "machin-poll help-json")
}
