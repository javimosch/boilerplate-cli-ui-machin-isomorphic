// The embedded guide and command catalog (cli-guide-spec, cli-output-spec §4).
//
// Compiled into the binary — an agent landing on a machine with this binary and
// no network can still learn the tool. Never fetched at runtime.

func guide_json() (s) {
    s = "{"
    s = s + "\"machin-poll\":\"An isomorphic machin app: one native binary serving its own WebAssembly UI.\","
    s = s + "\"version\":\"" + tool_version() + "\","
    s = s + "\"one_liner\":\"The same MFL source compiles twice — to native for the HTTP server and to WebAssembly for the browser — so the models and rendering logic are shared rather than reimplemented in JavaScript.\","
    s = s + "\"model\":{"
    s = s + "\"two targets\":\"build.sh compiles src/client.src to app.wasm and src/server.src to a native binary; both share src/models.src.\","
    s = s + "\"server\":\"machweb over a raw listener, bound to an explicit host:port, one goroutine per connection.\","
    s = s + "\"client\":\"a fine-grained reactive runtime (signals + a patch list) compiled to wasm, driven by a generic JS host.\","
    s = s + "\"ssr\":\"the server renders the same poll markup so the first paint needs no wasm round trip.\","
    s = s + "\"contract\":\"agent-first: data on stdout, context on stderr, semantic exit codes, typed errors, an embedded guide.\""
    s = s + "},"
    s = s + "\"loop\":["
    s = s + "\"./build.sh — compile the wasm client and the native server (needs zig for the wasm target)\","
    s = s + "\"./machin-poll serve — foreground on 127.0.0.1:48096\","
    s = s + "\"open http://127.0.0.1:48096/ and vote; the UI is wasm, the state is server-side\","
    s = s + "\"./machin-poll daemon start — background it instead\","
    s = s + "\"./machin-poll daemon stop — stop it\""
    s = s + "],"
    s = s + "\"concepts\":{"
    s = s + "\"isomorphic\":\"one language, two targets. src/models.src is compiled into both the server binary and the wasm client.\","
    s = s + "\"app.wasm is read from disk\":\"the server serves ./app.wasm from its working directory at request time — it is NOT embedded, so the daemon must keep the directory it was started from.\","
    s = s + "\"loopback default\":\"serve binds 127.0.0.1 unless --host says otherwise. Binding the whole network is deliberate.\","
    s = s + "\"shutdown token\":\"off-loopback, POST /_shutdown requires X-Shutdown-Token matching $SHUTDOWN_TOKEN, or it answers 403 and keeps running.\","
    s = s + "\"exit codes\":\"0 ok, 80-89 input, 90-99 state, 100-109 external, 110-119 internal. The code equals .error.code in the body.\""
    s = s + "},"
    s = s + "\"commands\":{\"server\":["
    s = s + "\"machin-poll serve [--host H] [--port N]\","
    s = s + "\"machin-poll daemon start [--port N]\","
    s = s + "\"machin-poll daemon stop [--port N]\","
    s = s + "\"machin-poll daemon status [--port N]\""
    s = s + "],\"introspection\":["
    s = s + "\"machin-poll guide [--human]\","
    s = s + "\"machin-poll help-json\","
    s = s + "\"machin-poll version [--json]\""
    s = s + "]},"
    s = s + "\"examples\":["
    s = s + "{\"goal\":\"serve the poll on a custom port\",\"do\":[\"./machin-poll serve --port 3000\"]},"
    s = s + "{\"goal\":\"background it and confirm it is up\",\"do\":[\"./machin-poll daemon start --port 3000\",\"./machin-poll daemon status --port 3000\"]},"
    s = s + "{\"goal\":\"read the current tally without a browser\",\"do\":[\"curl http://127.0.0.1:48096/api/results\"]}"
    s = s + "],"
    s = s + "\"gotchas\":["
    s = s + "\"app.wasm is served from the working directory, not embedded: start the binary from the directory that holds it, or the UI 404s.\","
    s = s + "\"Building the wasm target needs zig as the C-to-wasm compiler; the native half does not.\","
    s = s + "\"serve binds 127.0.0.1 by default. If you expected it on the LAN, pass --host 0.0.0.0 — and then set SHUTDOWN_TOKEN, or /_shutdown answers 403 to everyone.\","
    s = s + "\"Votes live in memory: stopping the daemon resets the tally.\","
    s = s + "\"daemon stop against a stopped daemon exits 0 — a no-op success, not an error.\""
    s = s + "],"
    s = s + "\"see_also\":[\"https://cli-specs.intrane.fr\",\"https://github.com/javimosch/machin\"]"
    s = s + "}"
}

func guide_markdown() (s) {
    s = "# machin-poll\n\n"
    s = s + "An isomorphic machin app: one native binary serving its own WebAssembly UI.\n\n"
    s = s + "## Model\n\n"
    s = s + "- The same MFL source compiles twice: native for the server, wasm for the UI.\n"
    s = s + "- src/models.src is shared by both, so nothing is reimplemented in JS.\n"
    s = s + "- The server renders the poll server-side for the first paint.\n"
    s = s + "- Agent-first: data on stdout, context on stderr, semantic exit codes.\n\n"
    s = s + "## Loop\n\n"
    s = s + "1. `./build.sh` (needs zig for the wasm target)\n"
    s = s + "2. `./machin-poll serve`\n"
    s = s + "3. Open http://127.0.0.1:48096/ and vote.\n"
    s = s + "4. `./machin-poll daemon start` to background it.\n"
    s = s + "5. `./machin-poll daemon stop` to stop it.\n\n"
    s = s + "## Commands\n\n"
    s = s + "- `serve [--host H] [--port N]`\n"
    s = s + "- `daemon start|stop|status [--port N]`\n"
    s = s + "- `guide [--human]`, `help-json`, `version [--json]`\n\n"
    s = s + "## Gotchas\n\n"
    s = s + "- `app.wasm` is served from the working directory, not embedded.\n"
    s = s + "- `serve` binds 127.0.0.1 by default; `--host 0.0.0.0` is deliberate.\n"
    s = s + "- Off-loopback, `POST /_shutdown` needs `X-Shutdown-Token` = `$SHUTDOWN_TOKEN`.\n"
    s = s + "- Votes are in memory; stopping the daemon resets the tally.\n"
}

func llms_txt() (s) {
    s = "# machin-poll\n\n"
    s = s + "An isomorphic machin app: one native binary serving its own wasm UI.\n\n"
    s = s + "## Drive it\n\n"
    s = s + "    machin-poll serve [--host H] [--port N]\n"
    s = s + "    machin-poll daemon start|stop|status [--port N]\n\n"
    s = s + "JSON on stdout, context on stderr, exit 0/80-119.\n\n"
    s = s + "## Learn it\n\n"
    s = s + "    machin-poll guide      # embedded, JSON\n"
    s = s + "    machin-poll help-json  # command catalog\n\n"
    s = s + "HTTP: GET /  GET /app.wasm  GET /api/results  GET /_health  POST /_shutdown\n"
}

func help_json() (s) {
    s = "{"
    s = s + "\"version\":\"1.0\","
    s = s + "\"tool\":\"machin-poll\","
    s = s + "\"tool_version\":\"" + tool_version() + "\","
    s = s + "\"commands\":["
    s = s + "{\"name\":\"serve\",\"summary\":\"run the HTTP server in the foreground\",\"flags\":[{\"name\":\"--host\",\"summary\":\"bind address\",\"default\":\"127.0.0.1\",\"env\":\"HOST\"},{\"name\":\"--port\",\"summary\":\"port\",\"default\":\"48096\",\"env\":\"PORT\"}]},"
    s = s + "{\"name\":\"daemon start\",\"summary\":\"start the server in the background (idempotent)\"},"
    s = s + "{\"name\":\"daemon stop\",\"summary\":\"stop the background server (no-op success if stopped)\"},"
    s = s + "{\"name\":\"daemon status\",\"summary\":\"report background server status\"},"
    s = s + "{\"name\":\"guide\",\"summary\":\"the embedded operator guide\",\"flags\":[{\"name\":\"--human\",\"summary\":\"markdown instead of JSON\"}]},"
    s = s + "{\"name\":\"help-json\",\"summary\":\"this machine-readable command catalog\"},"
    s = s + "{\"name\":\"version\",\"summary\":\"print the version\",\"flags\":[{\"name\":\"--json\",\"summary\":\"JSON output\"}]}"
    s = s + "],"
    s = s + "\"endpoints\":["
    s = s + "{\"method\":\"GET\",\"path\":\"/\",\"summary\":\"the server-rendered poll page\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/app.wasm\",\"summary\":\"the wasm UI, read from the working directory\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/api/results\",\"summary\":\"the current tally\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/api/vote?o=N\",\"summary\":\"cast a vote for option N\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/_health\",\"summary\":\"liveness: {ok,service,pid}\"},"
    s = s + "{\"method\":\"POST\",\"path\":\"/_shutdown\",\"summary\":\"stop the server; token-gated off-loopback\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/guide\",\"summary\":\"the guide over HTTP\"},"
    s = s + "{\"method\":\"GET\",\"path\":\"/llms.txt\",\"summary\":\"the short agent-facing README\"}"
    s = s + "],"
    s = s + "\"exit_codes\":{"
    s = s + "\"0\":\"success\","
    s = s + "\"80\":\"missing argument or bad flag value\","
    s = s + "\"85\":\"unknown command\","
    s = s + "\"90\":\"precondition failed (port unavailable, forbidden)\","
    s = s + "\"100\":\"external failure (the daemon did not answer)\""
    s = s + "},"
    s = s + "\"env\":[{\"name\":\"PORT\",\"summary\":\"default port\"},{\"name\":\"HOST\",\"summary\":\"default bind address\"},{\"name\":\"SHUTDOWN_TOKEN\",\"summary\":\"required by POST /_shutdown when bound off-loopback\"}],"
    s = s + "\"see_also\":[\"machin-poll guide\",\"https://cli-specs.intrane.fr\"]"
    s = s + "}"
}
